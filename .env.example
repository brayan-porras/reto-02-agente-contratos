# Proveedor LLM: anthropic | groq (la clave NUNCA se versiona ni llega al front)
LLM_PROVIDER=anthropic

# Si usas groq (capa gratuita): LLM_PROVIDER=groq y completa estas dos
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Tokens por minuto de tu plan en Groq (8000 en la capa gratuita); el agente espera para no pasarse
GROQ_TPM=8000

# Si usas anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=low
ANTHROPIC_MODEL=claude-haiku-5-5

# Servidor
PORT=3000
# Si se define, el chat exige esta clave de acceso (cabecera x-access-key)
ACCESS_KEY=

# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
LLM_TIMEOUT_MS=60000
